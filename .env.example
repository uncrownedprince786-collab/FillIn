# Copy to apps/web/.env.local and fill in real values locally.
# NEVER commit real values.

# OpenAI API key — server-side only. Never expose this to the extension or browser.
OPENAI_API_KEY=

# Optional: override the default model (defaults to gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini

# CORS origin allow-list, comma separated. Defaults to chrome-extension origins
# and http://localhost:5173 for development.
# ALLOWED_ORIGINS=https://example-extension-id.chromiumapp.org
