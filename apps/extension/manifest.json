{
  "manifest_version": 3,
  "name": "Fillin",
  "short_name": "Fillin",
  "version": "0.1.0",
  "description": "Forms, without the busywork. Fillin understands the forms you fill and uses the information you provided once.",
  "minimum_chrome_version": "116",
  "permissions": ["sidePanel", "activeTab", "tabs", "scripting", "storage"],
  "host_permissions": ["http://localhost/*", "https://*/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open Fillin",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' http://localhost:* http://127.0.0.1:* https://*; worker-src 'self';"
  },
  "web_accessible_resources": []
}